# Configuration reference only. Worker runtime vars belong in Wrangler vars/secrets,
# not VITE_* variables or a browser bundle. Local mock is already configured only
# in wrangler.jsonc env.local. Never deploy the local environment.
APP_ENV=production
APP_ORIGIN=
ACCESS_ISSUER=
ACCESS_AUD=
# Optional comma-separated verified Service Token Client IDs. Omit to use edge policy.
# ACCESS_SERVICE_TOKEN_IDS=
OWNER_EMAILS=
# Intentionally omit LOCAL_AUTH_MOCK from production.
# Service Token credentials belong only in the external Agent's secret store.

# Optional exact verified Client ID import subset. Omit for read-only; empty is invalid.
# ACCESS_IMPORT_TOKEN_IDS=
